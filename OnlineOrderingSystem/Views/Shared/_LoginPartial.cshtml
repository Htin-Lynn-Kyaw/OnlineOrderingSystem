@using Microsoft.AspNetCore.Identity
@using OnlineOrderingSystem.Models.Entities
@using OnlineOrderingSystem.Utilities

@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager

<ul class="navbar-nav">
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle" href="#" role="button" id="dropdownMenuLink" data-bs-toggle="dropdown" aria-expanded="false">
            @if (String.IsNullOrEmpty(UserManager.GetUserName(User)))
            {
                <text>Login or Signup</text>
            }
            else
            {
                @UserManager.GetUserName(User)
            }
        </a>
        <div class="dropdown-menu" aria-labelledby="dropdownMenuLink">
            @if (SignInManager.IsSignedIn(User))
            {
                <!-- Links when user is signed in -->
                <a class="dropdown-item" asp-controller="AccountManage" asp-action="Profile">Profile</a>
                <form id="logoutForm" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                    <button id="logout" type="submit" class="dropdown-item">Logout</button>
                </form>
                <div class="dropdown-divider"></div>
                @if (User.IsInRole(SystemsRoles.ADMIN))
                {
                    <select class="form-select" name="roles" id="roles" onchange="redirectToHomePage()">
                        <option value="Client" selected="@(ViewBag.UserRole == "Client")">Client</option>
                        <option value="Admin" selected="@(ViewBag.UserRole == "Admin")">Admin</option>
                    </select>
                }
            }
            else
            {
                <!-- Links when user is not signed in -->
                <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Register">Register</a>
                <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Login">Login</a>
            }
        </div>
    </li>
</ul>
